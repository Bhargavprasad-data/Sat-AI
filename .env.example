# ==============================================================================
# SatQuery AI - Environment Variables Template
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Satellite Data Retrieval Provider
# Supported options:
#   - earth_search (Default, AWS Open Data STAC for Sentinel-1 & Sentinel-2, Free/No Key required)
#   - planetary_computer (Microsoft Planetary Computer STAC)
#   - copernicus (Copernicus Data Space Ecosystem)
SATELLITE_PROVIDER=earth_search

# Optional Provider API Credentials (Leave empty for public open STAC catalogue)
SATELLITE_PROVIDER_API_KEY=
PLANETARY_COMPUTER_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Local Data Directories
CUSTOM_DOWNLOADS_DIR=demo-data/custom_downloads
CUSTOM_UPLOADS_DIR=demo-data/custom_uploads
